<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main id="home">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>

    <span class="badge reveal">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 14.4 7.2 16.9l.9-5.4L4.2 7.7l5.4-.8z"/></svg>
      FiveM Roleplay Community
    </span>

    <h1 class="reveal">أهلاً بك في <span class="grad-text">MAJAN</span></h1>
    <p class="hero-sub reveal">سيرفر FiveM احترافي يقدّم تجربة Roleplay فريدة بأنظمة متطورة ومجتمع نشط على مدار الساعة.</p>

    <div class="hero-buttons reveal">
      <a class="btn btn-gold btn-lg" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">
        Join Majan
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
      <% if (!user) { %>
        <a class="btn btn-outline btn-lg btn-discord" href="/auth/discord">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28c-1.71.29-3.35.81-4.93 1.51A20.26 20.26 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.3-2.1a12.9 12.9 0 0 1-2.05-.98c.17-.12.34-.25.5-.38a14.2 14.2 0 0 0 12.16 0c.17.13.33.26.5.38-.65.39-1.34.72-2.05.98.37.73.81 1.44 1.3 2.1a19.84 19.84 0 0 0 6.07-3.03 20.2 20.2 0 0 0-3.58-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Z"/></svg>
          تسجيل الدخول باستخدام Discord
        </a>
      <% } else { %>
        <a class="btn btn-outline btn-lg" href="/account">حسابي — <%= user.username %></a>
      <% } %>
    </div>

    <div class="stats reveal">
      <div class="stat"><strong data-count="12000" data-suffix="+">0</strong><span>عضو في المجتمع</span></div>
      <div class="stat"><strong data-count="350" data-suffix="+">0</strong><span>لاعب متصل الآن</span></div>
      <div class="stat"><strong data-count="24" data-suffix="/7">0</strong><span>تشغيل مستمر</span></div>
      <div class="stat"><strong data-count="99" data-suffix="%">0</strong><span>استقرار السيرفر</span></div>
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section class="section" id="features">
    <span class="eyebrow reveal">MAJAN COMMUNITY</span>
    <h2 class="section-title reveal">لماذا <span class="grad-text">Majan</span>؟</h2>
    <p class="section-sub reveal">كل ما تحتاجه لتجربة Roleplay متكاملة في مكان واحد.</p>

    <div class="cards-grid">
      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
        </div>
        <h3>سيرفر قوي</h3>
        <p>استضافة عالية الجودة تعمل على مدار الساعة دون تقطيع أو Lag.</p>
      </div>

      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>حماية متقدمة</h3>
        <p>نظام حماية ومكافحة غش متطور يضمن لعبًا عادلًا للجميع.</p>
      </div>

      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>مجتمع نشط</h3>
        <p>مجتمع متفاعل وفعال مع فعاليات ومسابقات باستمرار.</p>
      </div>

      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3>دعم فني</h3>
        <p>فريق دعم جاهز لمساعدتك وحل أي مشكلة بأسرع وقت.</p>
      </div>

      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3>اقتصاد متوازن</h3>
        <p>نظام اقتصاد مدروس يمنحك تجربة واقعية وممتعة داخل المدينة.</p>
      </div>

      <div class="info-card reveal">
        <div class="icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3>أداء سلس</h3>
        <p>سكربتات مُحسّنة بعناية تمنحك أداءً سلسًا على مختلف الأجهزة.</p>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section class="about-section section" id="about">
    <div class="about-panel reveal" aria-hidden="true">
      <div class="panel-logo">M</div>
      <div class="panel-lines"></div>
    </div>
    <div class="about-copy reveal">
      <span class="eyebrow">عن السيرفر</span>
      <h2>من نحن؟</h2>
      <p><strong>MAJAN</strong> هو سيرفر FiveM يهدف إلى تقديم أفضل تجربة Roleplay للاعبين، مع أنظمة متطورة ووظائف متنوعة ومجتمع احترافي يحترم القوانين.</p>
      <p>نعمل باستمرار على تطوير السيرفر وتحسين تجربة اللاعبين وتوفير بيئة لعب ممتعة وعادلة، بقيادة إدارة نشطة تسمع دائمًا لمقترحات المجتمع.</p>
      <ul class="checklist">
        <li>وظائف وأنشطة Roleplay متنوعة</li>
        <li>إدارة عادلة ونشطة</li>
        <li>تحديثات وتطوير مستمر</li>
      </ul>
      <a class="btn btn-outline" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">اكتشف المجتمع</a>
    </div>
  </section>

  <!-- ===== STEPS ===== -->
  <section class="section" id="steps">
    <span class="eyebrow reveal">GET STARTED</span>
    <h2 class="section-title reveal">ابدأ رحلتك في <span class="grad-text">3 خطوات</span></h2>

    <div class="steps">
      <div class="step-card reveal">
        <span class="step-num">01</span>
        <h3>انضم إلى Discord</h3>
        <p>اضغط على زر Join Majan ودخل سيرفر المجتمع على Discord.</p>
      </div>
      <div class="step-card reveal">
        <span class="step-num">02</span>
        <h3>سجّل دخولك بالموقع</h3>
        <p>سجّل الدخول بحساب Discord الخاص بك عبر زر تسجيل الدخول.</p>
      </div>
      <div class="step-card reveal">
        <span class="step-num">03</span>
        <h3>ابدأ اللعب</h3>
        <p>اتبع تعليمات القبول داخل السيرفر وابدأ قصتك في مدينة Majan.</p>
      </div>
    </div>
  </section>

  <!-- ===== RULES ===== -->
  <section class="rules-section reveal" id="rules">
    <div class="rules-copy">
      <span class="eyebrow">SERVER RULES</span>
      <h2>تجربة مختلفة، مجتمع أقوى</h2>
      <p>نلتزم بقوانين واضحة تحفظ جودة الـ Roleplay والاحترام المتبادل بين الجميع:</p>
      <ul class="rules-list">
        <li>الاحترام المتبادل إجباري — ممنوع الإساءة أو التنمر.</li>
        <li>ممنوع استخدام أي برامج غش أو استغلال ثغرات (Cheating).</li>
        <li>التزم بأسلوب Roleplay الواقعي داخل المدينة (No RDM / VDM).</li>
        <li>ممنوع نشر محتوى مسيء أو روابط دعائية بدون إذن.</li>
        <li>استمع لتعليمات الإدارة والفريق الداعم دائمًا.</li>
      </ul>
    </div>
    <div class="rules-cta">
      <a class="btn btn-gold btn-lg" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">انضم إلى Discord</a>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-section">
    <div class="cta-inner reveal">
      <h2>جاهز للانضمام إلى <span class="grad-text">Majan</span>؟</h2>
      <p>سجّل دخولك بحساب Discord أو انضم مباشرة إلى سيرفر المجتمع الآن.</p>
      <div class="hero-buttons">
        <a class="btn btn-gold btn-lg" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">Join Majan</a>
        <% if (!user) { %>
          <a class="btn btn-outline btn-lg btn-discord" href="/auth/discord">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.93-1.51 13.78 13.78 0 0 0-.64 1.28 18.27 18.27 0 0 0-5.5 0 12.64 12.64 0 0 0-.64-1.28c-1.71.29-3.35.81-4.93 1.51A20.26 20.26 0 0 0 .1 18.06a19.9 19.9 0 0 0 6.07 3.03c.49-.66.93-1.37 1.3-2.1a12.9 12.9 0 0 1-2.05-.98c.17-.12.34-.25.5-.38a14.2 14.2 0 0 0 12.16 0c.17.13.33.26.5.38-.65.39-1.34.72-2.05.98.37.73.81 1.44 1.3 2.1a19.84 19.84 0 0 0 6.07-3.03 20.2 20.2 0 0 0-3.58-13.69ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Zm7.96 0c-1.18 0-2.16-1.08-2.16-2.42s.95-2.42 2.16-2.42 2.18 1.09 2.16 2.42c0 1.34-.95 2.42-2.16 2.42Z"/></svg>
            تسجيل الدخول بـ Discord
          </a>
        <% } else { %>
          <a class="btn btn-outline btn-lg" href="/account">الذهاب إلى حسابي</a>
        <% } %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
