PORT=3000

# Discord Developer Portal → Your Application → OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Must match exactly what is registered in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# TERMINAL CITY Discord server invite link
DISCORD_INVITE_URL=https://discord.gg/tkj4Aw8jC

# TERMINAL CITY Discord server ID
DISCORD_GUILD_ID=1470791433547022377

# Long random string used to sign session cookies
SESSION_SECRET=change_this_to_a_random_long_secret

# Optional: override Discord API base URL (only for local testing/mocking)
# DISCORD_API_BASE=https://discord.com/api
